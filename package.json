    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.1-canary.11",
    "postcss": "^8.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  }
