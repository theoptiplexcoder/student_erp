# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PORT=3001

# Database (Supabase)
# App connection (transaction mode via pgbouncer — for runtime queries)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=5
# Direct connection (session mode — for migrations/seeds)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase — Client (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Supabase — Server only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# File Storage
STORAGE_BUCKET=uploads

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Sentry (optional)
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
