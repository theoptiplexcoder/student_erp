    "@nestjs/schedule": "^12.0.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/cron": "^2.4.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
